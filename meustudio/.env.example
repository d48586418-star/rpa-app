# MEU STUDIO — Variáveis de ambiente
# Copie este ficheiro para .env e preencha os valores reais.
# NUNCA commite o .env com valores reais.

# ── IA Gemini (obrigatório para o Assistente IA) ──────────────────
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Modelo Gemini (opcional — padrão: gemini-2.5-flash)
# Altere aqui para trocar de modelo sem editar código.
GEMINI_MODEL=gemini-2.5-flash

# ── Google Calendar OAuth (opcional) ─────────────────────────────
# Configure em: https://console.cloud.google.com/apis/credentials
# Tipo: Web application
# URI de redirecionamento autorizado: http://localhost:8000/api/calendar/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Sessão ───────────────────────────────────────────────────────
# Gerado automaticamente se ausente. Defina um valor fixo em produção.
SECRET_KEY=change-me-to-a-random-string-in-production

# ── Configurações opcionais ───────────────────────────────────────
# HOST e PORT para o servidor FastAPI
# HOST=0.0.0.0
# PORT=8000

# ── Chaves de terceiros (passadas pelo frontend nos headers X-*) ──
# Estas NÃO são variáveis de servidor — são configuradas pelo utilizador
# directamente na interface em Configurações > API Keys.
# Documentadas aqui apenas para referência:
# YOUTUBE_DATA_API_KEY  → header X-Youtube-Key
# GOOGLE_SEARCH_API_KEY → header X-Google-Key
# GOOGLE_SEARCH_CX_ID   → header X-Google-Cx
